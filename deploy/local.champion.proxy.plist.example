<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.champion.proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>${HOME}/qwen38-splash-262k/deploy/champion_proxy.py</string>
  </array>
  <key>WorkingDirectory</key><string>${HOME}/qwen38-splash-262k</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>${HOME}/Library/Logs/local-champion/proxy.log</string>
  <key>StandardErrorPath</key><string>${HOME}/Library/Logs/local-champion/proxy.log</string>
</dict>
</plist>
